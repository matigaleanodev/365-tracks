{
  "name": "365-tracks",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "start:fixtures": "ng serve --configuration fixtures",
    "test:watch": "ng test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:dist": "node scripts/verify-dist.mjs",
    "preview": "npm run build && npm run verify:dist && wrangler dev --ip 127.0.0.1",
    "verify:site": "node scripts/verify-site.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.5",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "postcss": "8.5.33",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.0",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11 <12"
  }
}
